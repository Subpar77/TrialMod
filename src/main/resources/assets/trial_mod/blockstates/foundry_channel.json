{
  "multipart": [
    {
      "when": { "north": "false", "south": "false" },
      "apply": { "model": "trial_mod:block/foundry_channel" }
    },
    {
      "when": {
        "AND": [
          { "east": "false", "west": "false" },
          { "OR": [{ "north": "true" }, { "south": "true" }] }
        ]
      },
      "apply": { "model": "trial_mod:block/foundry_channel", "y": 90 }
    },
    {
      "when": {
        "north": "true", "east": "true",
        "south": "false", "west": "false"
      },
      "apply": { "model": "trial_mod:block/foundry_channel_corner" }
    },
    {
      "when": {
        "north": "false", "east": "true",
        "south": "true", "west": "false"
      },
      "apply": { "model": "trial_mod:block/foundry_channel_corner", "y": 90 }
    },
    {
      "when": {
        "north": "false", "east": "false",
        "south": "true", "west": "true"
      },
      "apply": { "model": "trial_mod:block/foundry_channel_corner", "y": 180 }
    },
    {
      "when": {
        "north": "true", "east": "false",
        "south": "false", "west": "true"
      },
      "apply": { "model": "trial_mod:block/foundry_channel_corner", "y": 270 }
    },
    {
      "when": {
        "north": "true", "east": "true",
        "south": "false", "west": "false",
        "visual": "copper"
      },
      "apply": { "model": "trial_mod:block/foundry_channel_fluid_corner_copper" }
    },
    {
      "when": {
        "north": "false", "east": "true",
